# Copy to deploy/.env (it is git-ignored) and fill in every value. Never commit the real file.
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Behind HTTPS set COOKIE_SECURE=true, CORS_ORIGINS to the site's address and PUBLIC_API_URL to the API's address.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
GROQ_API_KEY=
GEMINI_API_KEY=
