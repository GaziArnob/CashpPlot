# Copy to .env and fill in. Everything works without any keys (template answers).

DATABASE_URL=sqlite:///./finance.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/finance   (pip install psycopg[binary])

SECRET_KEY=replace-with-a-long-random-string
# Optional Fernet key for field encryption: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Daily job: refresh scores and plan, alert on a predicted cash crunch
SCHEDULER_ENABLED=true
DAILY_JOB_HOUR=7

# Free LLM providers, tried in this order; unconfigured ones are skipped.
LLM_PROVIDERS=gemini,groq,ollama

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local, offline: install Ollama, then `ollama pull qwen2.5:7b`
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Receipt OCR (optional): install Tesseract, then set these if it is not on PATH
TESSERACT_CMD=
TESSDATA_PREFIX=

# Reminder delivery. Leave blank to send reminders yourself; each channel turns on when its keys are set.
# Email. Hosts that block SMTP (Render's free plan does) need an HTTPS provider: Brevo or Mailjet.
# Email, option 1: Mailjet over HTTPS (free plan 200 a day; verify one sender address)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
# Email, option 2: any mailbox through SMTP, including a free Gmail one (needs 2-step verification and an app password).
# Works on your own computer, not on Render's free plan.
# SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USER=you@gmail.com   SMTP_PASSWORD=<app password>   SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Email, option 2: Brevo (used first when both are set)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CashPilot
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# An approved template with 4 variables: {{1}} customer, {{2}} your business, {{3}} amount, {{4}} due date.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp through the same Twilio account (the sandbox number works for testing)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Which WhatsApp provider to use: auto (Meta if its keys are set, else Twilio), meta, or twilio
WHATSAPP_PROVIDER=auto

# Pro plan payments (Stripe). Use test keys first. BILLING_MODE=stripe turns checkout on; demo takes no payment.
BILLING_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# Bank connection (Plaid). Start with sandbox: sample banks, no real data.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
