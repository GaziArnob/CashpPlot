# Copy to .env and fill in. Everything works without any keys (template answers).

DATABASE_URL=sqlite:///./finance.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/finance   (pip install psycopg[binary])

SECRET_KEY=replace-with-a-long-random-string
# Optional Fernet key for field encryption: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Daily job: refresh scores and plan, alert on a predicted cash crunch
SCHEDULER_ENABLED=true
DAILY_JOB_HOUR=7

# Free LLM providers, tried in this order; unconfigured ones are skipped.
LLM_PROVIDERS=gemini,groq,ollama

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local, offline: install Ollama, then `ollama pull qwen2.5:7b`
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Receipt OCR (optional): install Tesseract, then set these if it is not on PATH
TESSERACT_CMD=
TESSDATA_PREFIX=
